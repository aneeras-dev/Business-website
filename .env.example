# Resend API key — server-only, never prefix with NEXT_PUBLIC_.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Sender. The domain must be verified in Resend or delivery will fail.
SALES_FROM_EMAIL="TripKnot Business <partners@mail.tripknot.in>"

# Inbox that receives new partner enquiries.
SALES_ADMIN_EMAIL=partners@tripknot.in
